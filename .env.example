# Copie para .env.local e preencha com valores próprios.

# Chave usada para assinar o cookie de sessão. Mínimo 16 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Contas do dashboard, como array JSON em uma única linha.
#
#   usuario  identificador digitado na tela de login
#   senha    senha em texto puro (a comparação é feita em tempo constante)
#   escopo   "admin"  → enxerga todas as matrizes
#            "matriz" → enxerga apenas a matriz indicada
#   matriz   obrigatório quando escopo = "matriz"; precisa bater EXATAMENTE
#            com o campo `matriz` que vem da API (ex.: "Sede Parque")
#   nome     rótulo exibido no cabeçalho (opcional)
#
# Para adicionar uma matriz nova, basta acrescentar um objeto a esta lista.
DASHBOARD_USUARIOS=[{"usuario":"admin","senha":"trocar","escopo":"admin","nome":"Administração Terruá"},{"usuario":"sede-parque","senha":"trocar","escopo":"matriz","matriz":"Sede Parque"}]

# Origem dos dados. Opcional — este é o padrão.
API_PESQUISAS_URL=https://api-rac-n-play.vercel.app/api/data/all?event=pesquisa
